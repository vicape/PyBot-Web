# Opción A — Solo login Google en el navegador (JWT en localStorage):
# OAuth web (Google Cloud Console > Credenciales > ID de cliente OAuth 2.0).
# Orígenes JS: http://localhost:5173 y tu dominio de producción.
VITE_GOOGLE_CLIENT_ID=

# Opción B — Plataforma (colegios en Supabase): si ambas están, prevalece Supabase OAuth.
# Proyecto: Settings > API. Ejecutá el SQL en supabase/migrations/ en el SQL Editor.
# En Auth > URL Configuration agregá: http://localhost:5173/auth/callback y https://TU_DOMINIO/auth/callback
# En Google OAuth (Supabase Provider y Cloud Console): habilitar Classroom API y scopes si usás Classroom.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
